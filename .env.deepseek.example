# DeepSeek 官方 API：V4.1 Flash 当前模型 ID 为 deepseek-flash。
# 复制为 .env 后填写自己的密钥，再启动/重启；不要提交 .env。
LLM_MODE=compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4096
# 首次接入先关闭思考；如要开启，设 enabled 并提高输出预算/超时。
LLM_THINKING=disabled
MAX_CONCURRENT_CHECKS=1
DEMO_SEED=false
NEWS_AUTO_REFRESH=true
NEWS_MEDIA_FETCH=true
