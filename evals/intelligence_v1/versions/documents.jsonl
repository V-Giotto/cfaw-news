{"available_at":"2026-01-05T12:00:00Z","canonical_url":"synthetic://dev01/e","cleaner_revision":"pr2-authored-nfc-lf-v1","content_kind":"synthetic_text","content_sha256":"77bfe7d6aaae03457a226c2598f80705ffc97cd7ac21dc8e2149e249fdf02843","doc_version_id":"d01:e:1","document_id":"d01:e","family_id":"family:dev01","first_seen_at":"2026-01-05T12:00:00Z","language":"en","observed_at":"2026-01-05T12:00:00Z","paragraphs":[{"paragraph_id":"p1","text":"We independently ran Cedar Agent v1.0 and Baseline Y on TinyBench-3 (three fixed toy tasks) on one Linux GPU machine."},{"paragraph_id":"p2","text":"Median elapsed time was lower for Cedar Agent on these three tasks in two runs. We did not test Windows CPU, other versions, or other workloads."},{"paragraph_id":"p3","text":"This small measurement does not establish universal speed gains or production reliability. We did not use the publisher speed table as our measurements."}],"provenance_uri":"DEV-01/README.md","published_at":"2026-01-05T12:00:00Z","published_time_confidence":"source_reported","record_origin":"synthetic","redistribution_rights":"synthetic","source_id":"dev01-test","source_type":"independent_test","submitted_at":null,"supersedes_version_id":null,"text_excerpt":null,"title":"Cedar Agent limited measurement","upstream_document_id":null}
