# 默认无联网模型调用，BM25 结果明确标为待人工核实。
LLM_MODE=baseline
# 可选：设为 compatible 后填写你自己的兼容 Chat Completions 接口。
# LLM_MODE=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2200
# provider_default 不发送额外参数；DeepSeek 可显式设 enabled / disabled。
LLM_THINKING=provider_default
MAX_CONCURRENT_CHECKS=2
DEMO_SEED=true
NEWS_AUTO_REFRESH=true
NEWS_MEDIA_FETCH=true
# false 关闭后台新闻获取，仍可手动刷新；新闻刷新不触发模型检查。
# 默认数据库在项目 .local/cfaw-news.db；环境与数据库不提交 Git。
# DATABASE_URL=sqlite:///D:/agent_project/cfaw-news/.local/cfaw-news.db
