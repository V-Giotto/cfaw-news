# 默认无联网模型调用，BM25 结果明确标为待人工核实。
LLM_MODE=baseline
# 可选：设为 compatible 后填写你自己的兼容 Chat Completions 接口。
# LLM_MODE=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
MAX_CONCURRENT_CHECKS=2
DEMO_SEED=true
# 默认数据库在项目 .local/cfaw-news.db；环境与数据库不提交 Git。
# DATABASE_URL=sqlite:///D:/agent_project/cfaw-news/.local/cfaw-news.db
